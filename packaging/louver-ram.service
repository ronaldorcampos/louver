# Louver's RAM RGB helper: sets Corsair DDR5 sticks' direct colours over the
# Intel SMBus for the per-user Louver daemon, which never gets /dev/i2c-*
# itself. Started by louver-ram.socket on the first connection; it exits
# once no client has been connected for a minute.
[Unit]
Description=Louver RAM RGB helper
Documentation=file:///usr/share/doc/louver/README.md
Requires=louver-ram.socket
After=louver-ram.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -m louver.ramhelper
# /dev/i2c-* and nothing else of /dev beyond the basics (null, urandom...).
DevicePolicy=closed
DeviceAllow=char-i2c rw
# Root only for the device node's permissions: no capabilities at all.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Nothing it does needs these (ioctl, open, read, write, socket I/O do not
# belong to either set), so they fail with EPERM instead of working.
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
# Nothing new can be created under /dev. Device nodes still open read-write
# on a read-only mount (the kernel only takes mount write access for regular
# files and directories), so /dev/i2c-* keeps working; DevicePolicy above is
# what limits which devices open at all.
ReadOnlyPaths=/dev
UMask=0077
MemoryMax=64M
TasksMax=4
