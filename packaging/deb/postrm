#!/bin/sh
set -e

if [ "$1" = remove ] || [ "$1" = purge ]; then
    if [ -S /run/udev/control ] && command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
    fi
    # Forget the RAM helper's units, now that their files are gone.
    if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl --system daemon-reload >/dev/null || true
    fi
fi
# As dh_installsystemd does: remove masks the socket, so its dangling enable
# link is inert until a reinstall unmasks it (and keeps the admin's choice);
# purge drops the link, the mask and deb-systemd-helper's record of them.
if command -v deb-systemd-helper >/dev/null 2>&1; then
    if [ "$1" = remove ]; then
        deb-systemd-helper mask louver-ram.socket >/dev/null || true
    fi
    if [ "$1" = purge ]; then
        deb-systemd-helper purge louver-ram.socket >/dev/null || true
        deb-systemd-helper unmask louver-ram.socket >/dev/null || true
    fi
fi

exit 0
