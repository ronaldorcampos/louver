#!/bin/sh
set -e

# systemctl --user "$@" for each logged-in user, best effort.
# The service is per user and never enabled globally: a global enable also
# starts it in the login screen's user session, which takes the port first.
each_user() {
    command -v loginctl >/dev/null 2>&1 || return 0
    loginctl list-users --no-legend 2>/dev/null | while read -r uid user _; do
        runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
            systemctl --user "$@" </dev/null >/dev/null 2>&1 || true  # keep the loop's stdin
    done
}

if [ "$1" = configure ]; then
    if command -v py3compile >/dev/null 2>&1; then
        py3compile -p louver
    fi
    # Apply the udev rule now, not at the next boot: the logged-in user can
    # open the hub, and plugdev can drive the motherboard headers. Only with
    # this system's own udevd running (not in a chroot or image build).
    if [ -S /run/udev/control ] && command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --action=change --subsystem-match=hidraw || true
        for chip in 'nct67*' 'it87*' 'it86*'; do  # the rule's hwmon part runs on add
            udevadm trigger --action=add --subsystem-match=hwmon --attr-match="name=$chip" || true
        done
    fi
    # An upgrade: running daemons move to the new code (and its web UI
    # files), under the new unit file if that changed too.
    each_user daemon-reload
    each_user try-restart louver.service
    echo "Louver: to start fan control now and at every login, run (as your user):"
    echo "  systemctl --user enable --now louver"
fi

# The RAM RGB helper's socket, the way dh_installsystemd does it: enabled on
# first install, and an admin's `systemctl disable` (or mask) of it kept
# across upgrades. It costs nothing while nobody connects: the helper only
# starts (and only touches the SMBus) once a client connects.
case "$1" in configure | abort-upgrade | abort-deconfigure | abort-remove)
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper unmask louver-ram.socket >/dev/null || true  # the mask postrm remove left
        if deb-systemd-helper --quiet was-enabled louver-ram.socket; then
            deb-systemd-helper enable louver-ram.socket >/dev/null || true
        else
            deb-systemd-helper update-state louver-ram.socket >/dev/null || true
        fi
    fi
    # Start it only with this system's systemd running (not for an install
    # into another root with DPKG_ROOT, in a chroot, an image build or a
    # container without systemd). deb-systemd-invoke starts only enabled units
    # and asks policy-rc.d first.
    if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --system daemon-reload >/dev/null || true
        fi
        if command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke start louver-ram.socket >/dev/null || true
            if [ -n "$2" ]; then  # an upgrade: a running helper moves to the new code
                deb-systemd-invoke try-restart louver-ram.service >/dev/null || true
            fi
        fi
    fi
    ;;
esac

exit 0
