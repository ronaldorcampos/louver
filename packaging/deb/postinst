#!/bin/sh
set -e

# systemctl --user "$@" for each logged-in user, best effort.
# The service is per user and never enabled globally: a global enable also
# starts it in the login screen's user session, which would drive the fans
# too (the machine-wide lock in /run/louver only stops that between plugdev
# members, and the login screen's account usually isn't one).
each_user() {
    command -v loginctl >/dev/null 2>&1 || return 0
    loginctl list-users --no-legend 2>/dev/null | while read -r uid user _; do
        runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
            systemctl --user "$@" </dev/null >/dev/null 2>&1 || true  # keep the loop's stdin
    done
}

if [ "$1" = configure ]; then
    if command -v py3compile >/dev/null 2>&1; then
        py3compile -p louver
    fi
    # Apply the udev rule now, not at the next boot: the logged-in user can
    # open the hub, and plugdev can drive the motherboard headers. Only with
    # this system's own udevd running (not in a chroot or image build).
    if [ -S /run/udev/control ] && command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules || true
        udevadm trigger --action=change --subsystem-match=hidraw || true
        for chip in 'nct67*' 'it87*' 'it86*'; do  # the rule's hwmon part runs on add
            udevadm trigger --action=add --subsystem-match=hwmon --attr-match="name=$chip" || true
        done
    fi
    # /run/louver now, not at the next boot: the machine-wide hardware lock's
    # directory (tmpfiles.d/louver.conf). Before the restarts below, so the
    # daemons they start take that lock too. Only with this system's systemd
    # running (not in a chroot, an image build or another root).
    if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ] && command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create louver.conf >/dev/null || true
    fi
    # Earlier builds shipped a RAM RGB root helper (louver-ram.socket and
    # .service), since removed. dpkg deletes its unit files, but the socket
    # may still be listening, and its enable link and deb-systemd-helper
    # state stay behind: stop it, then forget it. Only while that state is
    # there (deb-systemd-helper debian-installed: enabled, disabled by the
    # admin, or masked by a remove), so it runs once, not on every upgrade:
    # purge also sweeps empty directories under /etc/systemd/system.
    if [ -n "$2" ] && command -v deb-systemd-helper >/dev/null 2>&1 \
        && deb-systemd-helper debian-installed louver-ram.socket; then
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke stop louver-ram.socket louver-ram.service >/dev/null 2>&1 || true
        fi
        deb-systemd-helper purge louver-ram.socket >/dev/null || true
        deb-systemd-helper unmask louver-ram.socket >/dev/null || true
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            systemctl --system daemon-reload || true
        fi
    fi
    # An upgrade: running daemons move to the new code (and its web UI
    # files), under the new unit file if that changed too.
    each_user daemon-reload
    each_user try-restart louver.service
    echo "Louver: to start fan control now and at every login, run (as your user):"
    echo "  systemctl --user enable --now louver"
    if [ -n "$2" ]; then  # an open window still runs the old code, which may not reach the new service
        echo "Louver: if the Louver app is open, close its window, choose Quit from its tray icon, and open it again."
    fi
fi

exit 0
